{
  "manifest_version": 3,
  "name": "MySLT Direct Background Tracker",
  "version": "1.0",
  "description": "Fetch MySLT data directly in background without opening website",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://omniscapp.slt.lk/*",
    "https://myslt.slt.lk/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "slt_api_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://myslt.slt.lk/*"],
      "js": ["page_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://myslt.slt.lk/*"],
      "js": ["slt_utils.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MySLT Usage",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}